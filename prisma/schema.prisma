// UNDIMENSION — Prisma Schema
// Supports both SQLite (dev) and PostgreSQL (production)
// The provider is determined by the DATABASE_URL format:
//   - file:./db/custom.db → SQLite (local dev)
//   - postgresql://... → PostgreSQL (Render/Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local dev: SQLite | Production: PostgreSQL
  // For production, change provider to "postgresql" and set DATABASE_URL
  // to your Render/Supabase PostgreSQL connection string
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── For local dev with SQLite, use this instead: ──
// datasource db {
//   provider = "sqlite"
//   url      = env("DATABASE_URL")
// }

model Member {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nick        String
  role        String
  img         String
  color       String
  highlight   String
  bio         String
  statsJson   String   @default("[]")
  socialsJson String   @default("[]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  title     String
  img       String
  author    String
  date      String
  rotate    String   @default("-rotate-2")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  message   String
  color     String   @default("#ff4d4d")
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsArticle {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String   @default("UPDATE")
  author    String   @default("THE COLLECTIVE")
  img       String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
